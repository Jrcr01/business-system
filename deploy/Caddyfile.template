# Slick's system -- Caddy: HTTPS with an automatic certificate. /more/... goes to the Streamlit screens not moved yet, everything else to Django.
__SITE__ {
	encode zstd gzip
	handle /more* {
		reverse_proxy 127.0.0.1:8501
	}
	handle {
		reverse_proxy 127.0.0.1:8000
	}
	header {
		-Server
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}
	log {
		output file /var/log/caddy/slicks-erp.log {
			roll_size 10MiB
			roll_keep 10
		}
	}
}
