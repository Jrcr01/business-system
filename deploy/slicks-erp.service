[Unit]
Description=Slicks ERP (Django, gunicorn)
After=network.target

[Service]
User=slicks
Group=slicks
EnvironmentFile=/etc/slicks-erp/env
WorkingDirectory=/srv/slicks/app/current/erp
ExecStart=/srv/slicks/venv/bin/gunicorn config.wsgi:application --bind 127.0.0.1:8000 --workers 2 --timeout 30 --access-logfile -
Restart=always
RestartSec=3
# hardening: the ERP may write only its data, static and backup folders
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/slicks/data /srv/slicks/backups /srv/slicks/static

[Install]
WantedBy=multi-user.target
