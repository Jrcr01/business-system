# Slick's settings on the server (/etc/slicks-erp/env; made by bootstrap_server.sh). Never copy this file into git.
# ONE database for both programs (the Django system and the Streamlit screens not moved yet).
WEB_DB_PATH=/srv/slicks/data/__DBFILE__
AP_DB_PATH=/srv/slicks/data/__DBFILE__
# 1 only on the real site: the Django settings refuse a file named ap_disbursement.db without it
WEB_LIVE=__LIVE__
WEB_ALLOWED_HOSTS=__SITE__
WEB_SECRET_KEY=__SECRET__
WEB_STATIC_ROOT=/srv/slicks/static
# where the Streamlit screens are, for the Django pages that are not moved yet
WEB_STREAMLIT_URL=/more/
WEB_IDLE_MINUTES=120
# Cloudflare Access (zero trust): the team name and this application's audience tag, from the Cloudflare dashboard. Empty = the app does not check the pass.
WEB_CF_TEAM=
WEB_CF_AUD=
AP_BACKUP_DIR=/srv/slicks/backups
PYTHONIOENCODING=utf-8
