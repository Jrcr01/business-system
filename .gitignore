# Databases -- real business data (supplier/lender records, full credit card numbers, real
# checks) and disposable sandbox/test data alike. Never commit either; the sandbox/live split
# this project relies on assumes these files are always local-only.
data/*.db
data/*.db.bak_*
data/*.db-journal
data/*.db-wal
data/*.db-shm

# Legacy Access export files (real supplier/cardholder names, real amounts) pulled in for the
# one-time Phase 8a-8d migration.
data/source/

# Real financial figures from the migration's own analysis -- not source code, and not safe to
# publish even privately without thinking about it first.
opening_balances_review.csv

# Generated migration reports (report_8a.txt etc.) -- reproducible output, not source, and can
# carry real supplier names/amounts depending on what ran.
report_8*.txt

# Python runtime artifacts
__pycache__/
*.pyc
.pytest_cache/

# Streamlit runtime artifacts
streamlit.pid.txt
streamlit*.log

# Claude Code local/personal settings -- launch.json (sandbox+live launch config) stays tracked,
# settings.local.json is machine-specific.
.claude/settings.local.json

# ---- 2026-09-27 repository assessment: real data and generated files must never be committed ----
# Every database and database copy, wherever it sits (live data lives in C:\AP_Data, outside this folder)
data/
*.db
*.db.*
*.db-journal
# Exports, workbooks and printouts made from real data
*.csv
*.xlsx
*.xlsm
*.pdf
# ...except the Excel invoice-entry master, which the app itself needs (only a start sheet + supplier names)
!excel_invoice_entry/invoice_entry_master.xlsm
# Machine-specific settings and working notes with real data
live_db_path.txt
local_settings.bat
Cards_to_verify.md
Claude outputs/
# Google Drive login files for the thermal-statement QR copies (they live in C:\AP_Data\drive; never in git)
credentials.json
token.json
client_secret*.json
*oauth*.json

# Real bank statements downloaded from MBOS -- never commit
MBOS Latest statement/

# Slicks ERP (Django): its own Python environment, the laptop signing key, collected static files
.venv/

# Django site (web/): its signing key and collected static files stay local
web/.secret_key
web/staticfiles/
